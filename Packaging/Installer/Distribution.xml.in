<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>ChiaKey</title>
  <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <!-- Per-user only: installs into ~/Library/Input Methods with no admin prompt.
       System-wide installs go through the CLI (see README), not this GUI. -->
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <background file="InstallerBackground.png" mime-type="image/png" alignment="bottomleft" scaling="tofit"/>
  <background-darkAqua file="InstallerBackgroundDark.png" mime-type="image/png" alignment="bottomleft" scaling="tofit"/>
  <welcome file="Welcome.html" mime-type="text/html"/>
  <license file="License.txt" mime-type="text/plain"/>
  <conclusion file="Conclusion.txt" mime-type="text/plain"/>
  <choices-outline>
    <line choice="default"/>
  </choices-outline>
  <choice id="default" title="ChiaKey Input Method" description="Install the ChiaKey input method.">
    <pkg-ref id="__COMPONENT_IDENTIFIER__"/>
  </choice>
  <!-- No auth attribute: authorization follows the install domain, so the
       per-user home install needs no root.
       RequireLogout turns the conclusion pane's button into "Log Out": every
       running app caches the input source list per process, so a first install
       is only complete everywhere after a logout. Here postinstall passes
       the install subcommand with its wait-for-approval flag, which blocks
       until the user has answered macOS's consent dialog, so the button never
       appears before the input source is actually enabled. That wait is capped
       at half a minute: an approval lands in seconds, so past that nobody is
       answering, and the conclusion pane covers adding the input source by hand. /usr/sbin/installer sets
       COMMAND_LINE_INSTALL, so the CLI and updater paths skip both the wait
       and the forced logout. -->
  <pkg-ref id="__COMPONENT_IDENTIFIER__" version="__VERSION__" onConclusion="RequireLogout">__CLEAN_COMPONENT_PKG_NAME__</pkg-ref>
</installer-gui-script>
