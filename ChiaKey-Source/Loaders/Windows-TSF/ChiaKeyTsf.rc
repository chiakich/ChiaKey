#include <winres.h>

1 VERSIONINFO
 FILEVERSION CHIAKEY_VERSION_MAJOR,CHIAKEY_VERSION_MINOR,CHIAKEY_VERSION_PATCH,0
 PRODUCTVERSION CHIAKEY_VERSION_MAJOR,CHIAKEY_VERSION_MINOR,CHIAKEY_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ChiaKey"
            VALUE "FileDescription", "ChiaKey text service"
            VALUE "FileVersion", CHIAKEY_VERSION_STRING
            VALUE "InternalName", "ChiaKeyTsf.dll"
            VALUE "LegalCopyright", "See LICENSE.txt"
            VALUE "OriginalFilename", "ChiaKeyTsf.dll"
            VALUE "ProductName", "ChiaKey"
            VALUE "ProductVersion", CHIAKEY_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
